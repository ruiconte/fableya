# Supabase — récupère ces valeurs dans ton dashboard Supabase > Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role (uniquement côté serveur / Edge Functions — ne jamais exposer côté frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe — récupère ces valeurs dans le dashboard Stripe > Developers > API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price ID — crée un produit "Livre Kidoria" à 5€ dans Stripe et copie l'ID du prix ici
STRIPE_PRICE_ID=price_...

# URL de ton site (sans slash final)
# En développement : http://localhost:3000
# En production : https://tondomaine.com
SITE_URL=http://localhost:3000
