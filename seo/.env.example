# Server only. NEVER use a VITE_ prefix for a privileged key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Choose a Responses API model supporting web_search and structured outputs.
SEO_OPENAI_MODEL=
# Optional: read-only Google Search Console service-account credentials.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=sc-domain:fableya.com
# Optional external accounts you own. Empty disables all external publishing.
SEO_DESTINATIONS=
SEO_WORDPRESS_URL=
SEO_WORDPRESS_USER=
SEO_WORDPRESS_APP_PASSWORD=
SEO_DEV_API_KEY=
